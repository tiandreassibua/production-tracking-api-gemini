{
    "openapi": "3.0.0",
    "info": {
        "title": "Production Tracking API Documentation",
        "description": "API Documentation for Production Tracking System",
        "contact": {
            "email": "admin@example.com"
        },
        "version": "1.0.0"
    },
    "paths": {
        "/api/projects": {
            "post": {
                "tags": [
                    "Projects"
                ],
                "summary": "Store new project",
                "operationId": "48ad9efff74ef8cbc32998fcb386e258",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "client_id"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Proyek Renovasi Kantor"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Renovasi interior kantor pusat"
                                    },
                                    "client_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "due_date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2025-12-31"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Project created successfully"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Projects",
            "description": "Projects"
        }
    ]
}